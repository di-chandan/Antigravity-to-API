# AGY Local API configuration
# Copy this file to .env and adjust only what you need.

# Keep the API local to this Mac by default. Do not use 0.0.0.0 without securing access.
HOST=127.0.0.1
PORT=8788

# Leave blank to use ~/.local/bin/agy. Set an absolute path only if AGY is elsewhere.
AGY_BIN=

# Optional: leave blank to disable API-key auth (localhost-only use).
# Set a long random secret before exposing the API beyond this machine.
AGY_API_KEY=

# Request limits and session reuse settings. Values are milliseconds where noted.
AGY_TIMEOUT_MS=300000
AGY_MAX_CONCURRENT=1
AGY_MAX_QUEUE=10
AGY_MAX_SESSION_WORKERS=1
AGY_SESSION_IDLE_MS=300000

# Leave blank to store memory under this project's ./memory directory.
AGY_MEMORY_DIR=
